# STUDIO 23 environment configuration
# Copy to .env and fill in the secrets: cp .env.example .env
# Most variables are consumed by docker-compose.yml / docker-compose.rtmp.yml.
# The Advanced block at the bottom is read by the dashboard PROCESS, so those
# need a compose `environment:` entry to reach the container at all.

# --- Icecast (required, secrets) ---
# Internal auth between Liquidsoap, Icecast and the streamer.
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me
ICECAST_PASSWORD=change-me
ICECAST_RELAY_PASSWORD=change-me

# --- Dashboard (required, secrets) ---
# Bearer token for the dashboard REST API and WebSocket auth.
# REQUIRED. With no token set, the dashboard refuses all non-public API
# requests, every WebSocket connection and every SSO login, and says so once at
# startup. The public paths (health, status, rtmp-health and the live hooks)
# keep answering so probes still work. That is deliberate: a missing variable
# used to mean "let everyone in".
DASHBOARD_TOKEN=change-me
# Escape hatch for an instance that is genuinely meant to be open — a local
# experiment, or something already behind another gate. Only the exact string
# true counts, and DASHBOARD_TOKEN still wins if both are set.
# WARNING: with this on, ANYONE who can reach the port controls the stream and
# reads the live state feed. Never set it on anything internet-facing.
# AUTH_DISABLED=false
# AES-256 key used to encrypt RTMP stream keys at rest.
STREAM_KEYS_SECRET=change-me

# --- Streaming (optional) ---
# Output mode: hls (built-in player only) or rtmp (also push to RTMP destinations).
OUTPUT_MODE=hls
# Primary RTMP destination URL (only used when OUTPUT_MODE=rtmp).
RTMP_URL=
# Maximum number of simultaneous RTMP outputs.
MAX_PLATFORMS=3
# Maximum duration (seconds) of a single visual clip before switching.
MAX_CLIP_DURATION=60

# --- S3 content sync (optional) ---
# Set S3_ENABLED=true and fill endpoint/credentials to sync music and visuals
# with any S3-compatible storage.
S3_ENABLED=false
S3_ENDPOINT=
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=studio23
S3_REGION=eu-central-1
# Local cache size limit in MB.
S3_CACHE_MAX_MB=4000

# --- Multi-tenant / external services (optional) ---
# Tenant identifier (used as S3 prefix in multi-tenant setups).
TENANT_ID=default
# External transcoder service URL and its auth token (leave empty to disable).
TRANSCODER_URL=
TRANSCODER_TOKEN=

# --- Video encoding (streamer) ---
# The streamer encodes in SOFTWARE by default, which runs on any host.
#
# Intel QuickSync is opt-in through an overlay file, because it needs a device
# mount and a supplementary group and compose can interpolate values but cannot
# conditionally include a mapping:
#
#   docker compose -f docker-compose.yml -f docker-compose.hwaccel.yml up -d
#
# That overlay sets HW_ACCEL=qsv itself. Setting HW_ACCEL=qsv here WITHOUT the
# overlay asks ffmpeg for a GPU it has not been given, so leave it alone unless
# you know the device is mounted. Any other value, empty included, means
# libx264 (see the encoder branch in scripts/stream_entry.sh).
HW_ACCEL=
# Host GID of the 'render' group, used only by the overlay above. 105 on
# Debian/Ubuntu; 104 and 44 occur elsewhere, so check rather than assume:
#   getent group render | cut -d: -f3
RENDER_GID=105

# --- Advanced (container-internal, sane defaults; normally leave unset) ---
# WARNING: SHARED_DIR, MUSIC_DIR and VISUALS_DIR are MOUNT POINTS SHARED BETWEEN
# CONTAINERS — docker-compose mounts the same volume at the same path into
# liquidsoap, the streamer and the dashboard, and they hand off files through it
# (overlay.js, for one, writes ffmpeg filter files that the streamer container
# reads back by absolute path). Setting these for the dashboard alone desyncs
# that handoff. Change them only together with the compose mounts, or when
# running the dashboard outside Docker.
# PORT=9090
# HLS_DIR=/hls
# MUSIC_DIR=/music
# VISUALS_DIR=/visuals
# Shared state directory: json stores, txt handoff files, overlay assets.
# SHARED_DIR=/shared
# hls.js bundle, fetched into the image at build time (see dashboard/Dockerfile).
# HLS_JS_PATH=/app/hls.min.js
# Liquidsoap service the dashboard controls.
# DJ_HOST=dj
# DJ_PORT=7000
