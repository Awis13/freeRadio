# SYSTEM 23 — Configuration
# ──────────────────────────────────────
# OUTPUT_MODE=hls   → dry-run: стрим в браузере (http://localhost:8080)
# OUTPUT_MODE=rtmp  → live: стрим на YouTube/Kick
OUTPUT_MODE=hls

# RTMP ключ (нужен только для OUTPUT_MODE=rtmp)
RTMP_URL=rtmp://a.rtmp.youtube.com/live2/YOUR_STREAM_KEY

# Визуалы: сколько секунд показывать один клип
MAX_CLIP_DURATION=60
