{
  "dashboard": {
    "title": "SYSTEM 23 - Radio Stream",
    "tags": ["radio", "streaming"],
    "timezone": "browser",
    "schemaVersion": 27,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "FFmpeg Bitrate",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_ffmpeg_bitrate",
            "legendFormat": "Bitrate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bps",
            "min": 0
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "FFmpeg FPS",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_ffmpeg_fps",
            "legendFormat": "FPS"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "YouTube Connection",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_youtube_connected",
            "legendFormat": "Connected"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Offline"}}, "type": "value"},
              {"options": {"1": {"text": "Live"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Kick Connection",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_kick_connected",
            "legendFormat": "Connected"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Offline"}}, "type": "value"},
              {"options": {"1": {"text": "Live"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Current Track BPM",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_track_bpm",
            "legendFormat": "BPM"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "Analyzed Tracks",
        "type": "stat",
        "targets": [
          {
            "expr": "s23_analyzed_tracks",
            "legendFormat": "Tracks"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 4}
      },
      {
        "id": 7,
        "title": "CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 8,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "Used"
          },
          {
            "expr": "node_memory_MemAvailable_bytes",
            "legendFormat": "Available"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ]
  },
  "overwrite": true
}
